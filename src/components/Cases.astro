---
import { useTranslations, type Lang } from '../i18n/ui';
import { TELEGRAM_URL, PROJECTS } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const cases = [
  {
    name: 'Kalkulos',
    href: PROJECTS.kalkulos,
    linkText: 'kalkulos.com',
    live: false,
    logo: '/images/logo-kalkulos.png',
    showName: false,
    desc: t('cases.1.solution'),
  },
  {
    name: 'Nexum Group',
    href: PROJECTS.nexum,
    linkText: 'nexumgroup.work',
    live: false,
    logo: '/images/logo-nexum.png',
    showName: true,
    desc: t('cases.2.solution'),
  },
  {
    name: 'Asistente IA',
    href: TELEGRAM_URL,
    linkText: t('cases.3.cta'),
    live: true,
    logo: null,
    showName: true,
    desc: t('cases.3.solution'),
  },
];
---

<section id="projects" class="mx-auto max-w-6xl scroll-mt-20 px-5 pb-14 md:px-8 md:pb-20">
  <p class="mb-4 text-[13px] font-semibold tracking-[0.15em] text-electric uppercase">{t('cases.eyebrow')}</p>
  <h2
    class="font-display mb-2.5 max-w-[24ch] text-[clamp(1.9rem,4.5vw,2.6rem)] font-extrabold leading-[1.02] tracking-[-0.03em] text-navy"
  >
    {t('cases.title')}
  </h2>
  <p class="mb-8 max-w-[52ch] text-[15px] leading-[1.65] text-navy/62">{t('cases.sub')}</p>

  <div class="-mx-5 flex items-stretch gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:thin] md:-mx-8 md:px-8">
    {
      cases.map((c) => (
        <a
          href={c.href}
          target="_blank"
          rel="noopener"
          class="flex w-[260px] shrink-0 flex-col gap-4 rounded-xl border border-navy/12 bg-white p-6 transition-colors hover:border-electric/40"
        >
          <div class="flex h-8 items-center gap-3.5">
            {c.logo && <img src={c.logo} alt={c.name} class="h-8 w-auto max-w-[160px] object-contain object-left" />}
            {c.showName && <span class="text-[16px] font-medium text-navy">{c.name}</span>}
            {c.live && (
              <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-electric/10 px-2 py-0.5 text-[10px] font-medium tracking-[0.03em] text-navy uppercase">
                <span class="inline-block h-[5px] w-[5px] rounded-full bg-electric" aria-hidden="true" />
                En vivo
              </span>
            )}
          </div>

          <p class="text-[14px] leading-[1.55] text-navy/70">{c.desc}</p>

          <span class="mt-auto text-[13px] text-electric">{c.linkText} →</span>
        </a>
      ))
    }
  </div>
</section>
