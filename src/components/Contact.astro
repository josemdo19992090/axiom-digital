---
import { useTranslations, type Lang } from '../i18n/ui';
import { TELEGRAM_URL, WEB3FORMS_KEY } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="scroll-mt-20 bg-navy">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_420px] lg:gap-14">
      <div>
        <p class="mb-4 text-[13px] font-semibold tracking-[0.15em] text-electric uppercase">
          {t('contact.eyebrow')}
        </p>
        <h2
          class="font-display max-w-[20ch] text-[clamp(1.9rem,4.5vw,2.6rem)] font-extrabold leading-[1.02] tracking-[-0.03em] text-white"
        >
          {t('contact.title')}
        </h2>
        <p class="mt-3 max-w-[48ch] text-[15px] leading-[1.65] text-white/60">
          {t('contact.sub')}
        </p>

        <a
          href={TELEGRAM_URL}
          target="_blank"
          rel="noopener"
          class="mt-7 inline-flex min-h-[48px] items-center gap-2 rounded-md bg-electric px-6 text-[15px] font-medium text-white transition-opacity hover:opacity-85"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M21.9 4.3 19 19.2c-.2 1-.8 1.2-1.6.8l-4.4-3.2-2.1 2c-.2.3-.4.4-.9.4l.3-4.5 8.2-7.4c.4-.3-.1-.5-.6-.2L7.7 13.4l-4.3-1.3c-.9-.3-1-.9.2-1.4l16.8-6.5c.8-.3 1.5.2 1.5 1.1Z"
            ></path>
          </svg>
          {t('contact.telegram')}
        </a>
      </div>

      <div class="rounded-xl border border-white/12 bg-white/5 p-6">
        <p class="mb-5 text-[12px] tracking-[0.1em] text-white/50 uppercase">
          {t('contact.form.label')}
        </p>

        <form id="lead-form" class="flex flex-col gap-3.5" novalidate>
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="Nuevo lead desde axiomadigital.tech" />
          <input type="hidden" name="from_name" value="Axioma Digital" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" />

          <div>
            <label for="name" class="mb-1.5 block text-[12px] text-white/55"
              >{t('contact.form.name')}</label
            >
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder={t('contact.form.name.ph')}
              class="min-h-[46px] w-full rounded-md border border-white/14 bg-white/7 px-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-electric focus:outline-none"
            />
          </div>

          <div>
            <label for="email" class="mb-1.5 block text-[12px] text-white/55"
              >{t('contact.form.email')}</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder={t('contact.form.email.ph')}
              class="min-h-[46px] w-full rounded-md border border-white/14 bg-white/7 px-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-electric focus:outline-none"
            />
          </div>

          <div>
            <label for="phone" class="mb-1.5 block text-[12px] text-white/55"
              >{t('contact.form.phone')}</label
            >
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder={t('contact.form.phone.ph')}
              class="min-h-[46px] w-full rounded-md border border-white/14 bg-white/7 px-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-electric focus:outline-none"
            />
          </div>

          <div>
            <label for="service" class="mb-1.5 block text-[12px] text-white/55"
              >{t('contact.form.service')}</label
            >
            <select
              id="service"
              name="service"
              class="min-h-[46px] w-full appearance-none rounded-md border border-white/14 bg-white/7 px-3.5 text-[14px] text-white focus:border-electric focus:outline-none"
            >
              <option class="text-navy" value={t('contact.form.service.1')}
                >{t('contact.form.service.1')}</option
              >
              <option class="text-navy" value={t('contact.form.service.2')}
                >{t('contact.form.service.2')}</option
              >
              <option class="text-navy" value={t('contact.form.service.3')}
                >{t('contact.form.service.3')}</option
              >
              <option class="text-navy" value={t('contact.form.service.4')}
                >{t('contact.form.service.4')}</option
              >
              <option class="text-navy" value={t('contact.form.service.5')}
                >{t('contact.form.service.5')}</option
              >
            </select>
          </div>

          <button
            type="submit"
            class="mt-2 min-h-[48px] rounded-md bg-white text-[15px] font-medium text-navy transition-opacity hover:opacity-88"
          >
            {t('contact.form.submit')}
          </button>

          <p
            id="form-status"
            class="hidden text-[13px] leading-[1.6]"
            role="status"
            aria-live="polite"
          >
          </p>

          <p class="text-[11px] leading-[1.6] text-white/35">{t('contact.form.privacy')}</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    sending: t('contact.form.sending'),
    submit: t('contact.form.submit'),
    success: t('contact.form.success'),
    error: t('contact.form.error'),
  }}
>
  const form = document.getElementById('lead-form');
  const status = document.getElementById('form-status');
  const button = form.querySelector('button[type="submit"]');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    button.disabled = true;
    button.textContent = sending;
    status.className = 'hidden';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });

      if (!res.ok) throw new Error('bad response');

      form.reset();
      status.className = 'text-[13px] leading-[1.6] text-white';
      status.textContent = success;
    } catch {
      status.className = 'text-[13px] leading-[1.6] text-red-300';
      status.textContent = error;
    } finally {
      button.disabled = false;
      button.textContent = submit;
    }
  });
</script>
