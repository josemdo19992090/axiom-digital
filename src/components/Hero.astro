---
import { useTranslations, type Lang } from '../i18n/ui';
import { TELEGRAM_URL, PROJECTS } from '../config';
import TelegramIcon from './TelegramIcon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="relative h-[280px] w-full overflow-hidden md:h-[380px]">
  <img
    src="/images/hero-top.jpg"
    alt=""
    loading="eager"
    class="h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-navy/55 via-navy/20 to-paper"></div>
</div>

<section class="mx-auto max-w-6xl px-5 pt-14 pb-10 md:px-8 md:pt-20">
  <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
    <div>
      <p class="mb-5 text-[13px] font-semibold tracking-[0.15em] text-electric uppercase">
        {t('hero.eyebrow')}
      </p>

      <h1
        class="font-display text-[clamp(2.5rem,7.5vw,4rem)] font-extrabold leading-[0.98] tracking-[-0.035em] text-navy"
      >
        {t('hero.title.a')}
        <span class="text-electric">{t('hero.title.b')}</span>.
      </h1>

      <p class="mt-5 max-w-[46ch] text-[16px] leading-[1.65] text-navy/62 md:text-[17px]">
        {t('hero.sub')}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={TELEGRAM_URL}
          target="_blank"
          rel="noopener"
          class="flex min-h-[48px] items-center gap-2 rounded-md bg-navy px-6 text-[15px] font-medium text-white transition-opacity hover:opacity-88"
        >
          <TelegramIcon size={17} />
          {t('hero.cta.primary')}
        </a>

        <a
          href="#projects"
          class="flex min-h-[48px] items-center rounded-md border border-navy/20 px-6 text-[15px] font-medium text-navy transition-colors hover:border-navy/45"
          >{t('hero.cta.secondary')}</a
        >
      </div>
    </div>

    <div class="rounded-xl bg-navy p-5 md:p-6">
      <div class="mb-4 flex items-center gap-2">
        <span class="inline-block h-[7px] w-[7px] rounded-full bg-electric"></span>
        <span class="text-[11px] tracking-[0.1em] text-white/50 uppercase"
          >{t('hero.demo.label')}</span
        >
      </div>

      <div class="flex flex-col gap-2.5">
        <p
          class="max-w-[80%] self-start rounded-xl rounded-bl-sm bg-white/10 px-3.5 py-2.5 text-[14px] leading-[1.55] text-white/92"
        >
          {t('hero.demo.msg1')}
        </p>
        <p
          class="max-w-[80%] self-end rounded-xl rounded-br-sm bg-electric px-3.5 py-2.5 text-[14px] leading-[1.55] text-white"
        >
          {t('hero.demo.msg2')}
        </p>
      </div>

      <a
        href={TELEGRAM_URL}
        target="_blank"
        rel="noopener"
        class="mt-5 flex min-h-[44px] items-center justify-center rounded-md border border-white/20 text-[14px] text-white/85 transition-colors hover:border-white/45"
      >
        {t('cases.3.cta')} →
      </a>
    </div>
  </div>

  <div class="mt-14 border-t border-navy/10 pt-5">
    <p class="mb-2.5 text-[12px] font-medium tracking-[0.1em] text-navy/50 uppercase">
      {t('hero.proof.label')}
    </p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[15px]">
      <a
        href={PROJECTS.kalkulos}
        target="_blank"
        rel="noopener"
        class="text-navy transition-colors hover:text-electric">Kalkulos</a
      >
      <span class="text-navy/20" aria-hidden="true">/</span>
      <a
        href={PROJECTS.nexum}
        target="_blank"
        rel="noopener"
        class="text-navy transition-colors hover:text-electric">Nexum Group</a
      >
      <span class="text-navy/20" aria-hidden="true">/</span>
      <a
        href={TELEGRAM_URL}
        target="_blank"
        rel="noopener"
        class="text-navy transition-colors hover:text-electric">Asistente IA</a
      >
    </div>
  </div>
</section>
