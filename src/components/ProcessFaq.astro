---
import { useTranslations, faq, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { n: 1, name: t('process.1.name'), desc: t('process.1.desc') },
  { n: 2, name: t('process.2.name'), desc: t('process.2.desc') },
  { n: 3, name: t('process.3.name'), desc: t('process.3.desc') },
  { n: 4, name: t('process.4.name'), desc: t('process.4.desc') },
];

const questions = faq[lang];
---

<section id="process" class="mx-auto max-w-6xl scroll-mt-20 px-5 pb-14 md:px-8 md:pb-20">
  <p class="mb-4 text-[11px] tracking-[0.18em] text-electric uppercase">{t('process.eyebrow')}</p>
  <h2
    class="font-display mb-8 max-w-[20ch] text-[clamp(1.9rem,4.5vw,2.5rem)] leading-[1.12] text-navy"
  >
    {t('process.title')}
  </h2>

  <ol class="grid gap-6 border-t border-navy/15 pt-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((s) => (
        <li>
          <span
            class={`mb-3 flex h-7 w-7 items-center justify-center rounded-full text-[12px] text-white ${s.n === 4 ? 'bg-electric' : 'bg-navy'}`}
            aria-hidden="true"
          >
            {s.n}
          </span>
          <h3 class="mb-1.5 text-[16px] font-medium text-navy">{s.name}</h3>
          <p class="text-[14px] leading-[1.6] text-navy/60">{s.desc}</p>
        </li>
      ))
    }
  </ol>
</section>

<section class="mx-auto max-w-6xl px-5 pb-14 md:px-8 md:pb-20">
  <p class="mb-4 text-[11px] tracking-[0.18em] text-electric uppercase">{t('faq.eyebrow')}</p>
  <h2
    class="font-display mb-7 max-w-[24ch] text-[clamp(1.9rem,4.5vw,2.5rem)] leading-[1.12] text-navy"
  >
    {t('faq.title')}
  </h2>

  <div class="max-w-3xl border-t border-navy/12">
    {
      questions.map((item, i) => (
        <details class="group border-b border-navy/12 py-4" open={i === 0}>
          <summary class="flex min-h-[32px] items-center justify-between gap-4 text-[16px] text-navy">
            {item.q}
            <span
              class="faq-icon shrink-0 text-[20px] leading-none text-electric transition-transform duration-200"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="mt-3 max-w-[62ch] text-[14px] leading-[1.7] text-navy/62">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
