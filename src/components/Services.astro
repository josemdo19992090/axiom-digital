---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    n: '01',
    name: t('services.1.name'),
    desc: t('services.1.desc'),
    tags: t('services.1.tags').split('|'),
    badge: null,
    featured: false,
  },
  {
    n: '02',
    name: t('services.2.name'),
    desc: t('services.2.desc'),
    tags: t('services.2.tags').split('|'),
    badge: t('services.2.badge'),
    featured: true,
  },
  {
    n: '03',
    name: t('services.3.name'),
    desc: t('services.3.desc'),
    tags: t('services.3.tags').split('|'),
    badge: null,
    featured: false,
  },
];

const pains = [t('pains.1'), t('pains.2'), t('pains.3')];
---

<section class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
  <p class="mb-4 text-[11px] font-semibold tracking-[0.2em] text-electric uppercase">{t('pains.eyebrow')}</p>
  <h2
    class="font-display max-w-[22ch] text-[clamp(1.9rem,4.5vw,2.6rem)] font-extrabold leading-[1.02] tracking-[-0.03em] text-navy"
  >
    {t('pains.title')}
  </h2>

  <ul class="mt-8 grid gap-4 md:grid-cols-3">
    {
      pains.map((p) => (
        <li class="rounded-xl border border-navy/12 bg-white p-5">
          <p class="text-[16px] leading-[1.55] font-medium text-navy">“{p}”</p>
        </li>
      ))
    }
  </ul>
</section>

<section id="services" class="mx-auto max-w-6xl scroll-mt-20 px-5 pb-14 md:px-8 md:pb-20">
  <p class="mb-4 text-[11px] font-semibold tracking-[0.2em] text-electric uppercase">{t('services.eyebrow')}</p>
  <h2
    class="font-display mb-8 max-w-[20ch] text-[clamp(1.9rem,4.5vw,2.6rem)] font-extrabold leading-[1.02] tracking-[-0.03em] text-navy"
  >
    {t('services.title')}
  </h2>

  <div>
    {
      services.map((s, i) => (
        <div
          class={`flex gap-5 border-t border-navy/12 py-6 ${s.featured ? 'bg-electric/4 px-4 md:px-6 -mx-4 md:-mx-6' : ''} ${i === services.length - 1 ? 'border-b' : ''}`}
        >
          <span class="font-display min-w-[34px] text-[15px] font-bold leading-none text-electric tracking-[0.02em]">
            {s.n}
          </span>
          <div>
            <div class="mb-2 flex flex-wrap items-center gap-2.5">
              <h3 class="text-[18px] font-medium text-navy">{s.name}</h3>
              {s.badge && (
                <span class="rounded-full border border-electric/40 px-2.5 py-0.5 text-[10px] tracking-[0.08em] text-electric uppercase">
                  {s.badge}
                </span>
              )}
            </div>
            <p class="mb-3 max-w-[54ch] text-[15px] leading-[1.65] text-navy/62">{s.desc}</p>
            <div class="flex flex-wrap gap-2">
              {s.tags.map((tag) => (
                <span class="rounded-md bg-electric/10 px-2.5 py-1 text-[11px] text-navy">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <p class="mt-6 text-[14px] text-navy/55">
    {t('services.footnote')}
    <a href="#contact" class="text-electric underline decoration-electric/30 underline-offset-2"
      >{t('services.footnote.link')}</a
    >.
  </p>
</section>
